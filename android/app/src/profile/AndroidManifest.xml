<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.piliplus">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Impeller 实验开关（排期 #11 第 0 步）。只在 profile 覆盖里打开，main 保持 false。
         tools:replace="android:value" 必须写：main 里已有同名 meta-data（value=false），
         值不同会让 manifest merger 直接报冲突。
         退回：删掉这个 meta-data 节点再重建；或用 am start 的 enable-impeller extra 置 false
         （前提是该 extra 在引擎版本里生效）。 -->
    <application>
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true"
            tools:replace="android:value" />
    </application>
</manifest>