!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages
!/dev/ci/**/Gemfile.lock
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

devtools_options.yaml

# FVM Version Cache
.fvm/

pili_release.json

dist

test*

# 我们自己的测试要入库（上游 test* 规则会连带忽略 test/ 下所有内容）：
# 先取回 test/ 本身，再忽略其中的非自有内容，最后取回 test/own/
!test/
test/*
!test/own/
!test/own/**

# LiquidGlassKit 例外：上游 test* 规则会连带忽略我们的包测试（父目录必须先取回）
!packages/liquid_glass_kit/test/
!packages/liquid_glass_kit/test/**

# 嵌套包的构建产物（上游 /build/ 只锚定根目录，管不到 packages/*/build）
packages/*/build/

# smoke test 生成的存活报告属于运行产物，不入库
tool/smoke-reports/

# 字体/图标流水线的源素材缓存（15~18MB 级源字体按 URL 现取，不入库）
tool/.cache/

# EOF
# 测试用 RSA 夹具（私钥不随仓库分发，避免密钥扫描告警）
test/own/.credential_refresh_kat.json
